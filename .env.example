# ===========================================
# Allegro Price Monitor - Konfiguracja
# ===========================================
# Skopiuj ten plik jako .env i uzupełnij wartości
# cp .env.example .env

# -------------------------------------------
# Allegro API (opcjonalne - obecnie zablokowane)
# -------------------------------------------
# Uzyskaj na: https://apps.developer.allegro.pl/
# Uwaga: Endpoint /offers/listing wymaga weryfikacji aplikacji,
# która jest obecnie wstrzymana przez Allegro.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=

# -------------------------------------------
# scrape.do (WYMAGANE do scrapowania)
# -------------------------------------------
# Uzyskaj darmowe konto na: https://scrape.do/
# Darmowy plan: 1000 kredytów/miesiąc
# Koszty dla Allegro:
#   - render=true (z JavaScript): 5 kredytów/zapytanie
#   - render=false (bez JS): 1 kredyt/zapytanie
SCRAPE_DO_TOKEN=

# -------------------------------------------
# Opcjonalne ustawienia
# -------------------------------------------
# Wyłącz ostrzeżenia SSL (Windows)
# PYTHONWARNINGS=ignore:Unverified HTTPS request
